# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in. Never commit `.env`.
#
#   cp .env.example .env
#   php tools/keygen.php        <- prints ready-to-paste APP_KEY / JWT_SECRET
# ---------------------------------------------------------------------------

APP_NAME="MyTasks API"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/xxp/mytasks/api
APP_TIMEZONE=Africa/Casablanca

# --- Database (WAMP defaults: root with an empty password) ------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mytasks
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Encryption -------------------------------------------------------------
# APP_KEY encrypts vault passwords and TOTP secrets (AES-256-CBC + HMAC).
# It must be exactly 32 bytes, base64 encoded, prefixed with "base64:".
# WARNING: changing this makes every stored vault password undecryptable.
APP_KEY=

# --- JWT --------------------------------------------------------------------
JWT_SECRET=
JWT_ISSUER=mytasks-api
JWT_ACCESS_TTL=900              # access token lifetime, seconds (15 min)
JWT_REFRESH_TTL=2592000         # refresh token lifetime, seconds (30 days)
JWT_CHALLENGE_TTL=300           # 2FA challenge token lifetime, seconds (5 min)
JWT_VAULT_TTL=300               # vault unlock lifetime, seconds (5 min)

# --- Refresh token cookie ---------------------------------------------------
REFRESH_COOKIE_NAME=mytasks_refresh
REFRESH_COOKIE_SECURE=false     # set true once you serve over HTTPS
REFRESH_COOKIE_SAMESITE=Lax     # None (+Secure=true) if web client is cross-origin
# Leave unset: the API scopes the cookie to its own URL automatically, so
# moving the folder can't silently break session refresh. Set it only when a
# proxy rewrites the path in front of you.
#REFRESH_COOKIE_PATH=/xxp/mytasks/api

# --- Two-factor -------------------------------------------------------------
TWO_FACTOR_REQUIRED=true        # false = skip 2FA for users who haven't enrolled
OTP_LENGTH=6
OTP_TTL=300                     # email OTP lifetime, seconds
OTP_MAX_ATTEMPTS=5
TOTP_ISSUER=MyTasks
TOTP_WINDOW=1                   # accept +/- N 30s steps for clock drift

# --- Mail (email OTP delivery) ----------------------------------------------
# MAIL_DRIVER=log writes the OTP to storage/logs/mail.log instead of sending —
# ideal on WAMP where mail() usually isn't configured.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@mytasks.local
MAIL_FROM_NAME="MyTasks"

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_LOGIN=10             # attempts per window, per IP+email
RATE_LIMIT_WINDOW=900           # window, seconds
LOGIN_MAX_FAILURES=5            # failures before the account locks
LOGIN_LOCK_MINUTES=15

# --- CORS -------------------------------------------------------------------
# Comma-separated origins, or * for any (development only).
CORS_ALLOWED_ORIGINS=*

# --- Backups ------------------------------------------------------------
# There is no admin role (see README), so a full backup — every user's data
# plus this .env file — needs more than a normal login. Set a long random
# value here and send it as the X-Backup-Key header (tools/backup.php on the
# CLI doesn't need it). Leave blank to disable backups from the web UI.
BACKUP_KEY=
# How many local backups the CLI tool and the web UI keep before pruning.
BACKUP_KEEP=10

# How long the audit trail is kept, in days. Pruned by tools/reminders.php.
# 0 keeps everything forever (the table then grows without bound).
AUDIT_RETENTION_DAYS=365
# Optional: AES-256 encrypts every file inside the zip with this passphrase.
# The archive already contains APP_KEY and your DB password, so if it will
# ever leave this server (e.g. Google Drive), set this.
BACKUP_ZIP_PASSWORD=

# --- Google Drive (optional backup destination) ------------------------
# A Google Cloud service-account JSON key (absolute path, or relative to
# api/). Share a Drive folder with the key's client_email (Editor access) —
# service accounts have no storage quota of their own.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_FOLDER_ID=

# --- Chat box AI fallback (optional, local only) -----------------------
# The command chat's own fixed-grammar parser handles most phrasings without
# any of this. Anything it doesn't recognize is sent to a locally-running
# Ollama server (https://ollama.com — `ollama pull llama3.1`, then
# `ollama serve`) to interpret instead. No cloud API, no API key, nothing
# leaves this machine. If Ollama isn't running, the chat just falls back to
# "I didn't understand that" — the rest of the app is unaffected either way.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
# A CPU-bound local model can take 10-25s per reply, more under load (e.g.
# your browser doing other things at the same time) — raise this on slower
# hardware rather than have it 503 mid-generation.
OLLAMA_TIMEOUT=60

# --- Voice input (optional, local) --------------------------------------
# The mic button records a clip in the browser and uploads it here, which
# forwards it to a locally-running whisper.cpp server (its `server` example,
# not a Python install) for transcription. This is what makes voice input
# fully private — the browser's own SpeechRecognition works with zero setup
# too, but sends your audio to Google's servers; this doesn't.
# Setup: build github.com/ggerganov/whisper.cpp, download a ggml model
# (`sh ./models/download-ggml-model.sh base.en`), then run its server on
# this port: `./build/bin/server -m models/ggml-base.en.bin --port 8081`
WHISPER_URL=http://127.0.0.1:8081
# Bigger multilingual models (medium/large) are noticeably slower per clip
# on CPU-only setups, and the server only processes one request at a time —
# 30s can be too tight once a queue builds up. 60 gives more headroom.
WHISPER_TIMEOUT=60
# 'auto' lets whisper.cpp detect the spoken language on its own — needs a
# MULTILINGUAL model though (no ".en" in the filename, e.g. ggml-medium.bin;
# an .en model only ever understands English no matter what this says). Set
# a fixed code (e.g. "ar", "fr") instead of "auto" if detection guesses
# wrong on short clips, which auto-detect is prone to.
WHISPER_LANGUAGE=auto

# --- Voice output (optional, local, more realistic than the browser) -------
# The speaker reads replies aloud using the browser's own speechSynthesis by
# default — zero setup, but robotic-sounding. Set these two paths to a local
# Piper install (https://github.com/rhasspy/piper — a small CLI, not a
# server) for genuinely natural neural voices, still fully private since the
# text never leaves this machine.
# Setup: download a Piper release for your OS, plus one voice — a matching
# pair of files, e.g. `en_US-lessac-medium.onnx` and
# `en_US-lessac-medium.onnx.json` (both required, same folder). Point these
# at the exe and the .onnx file; leave blank to keep using the browser voice.
PIPER_EXE_PATH=
PIPER_MODEL_PATH=
# Optional: a second, Arabic-specific voice (e.g. `ar_JO-kareem-low.onnx`
# from https://huggingface.co/rhasspy/piper-voices). Piper voices are
# per-language — PIPER_MODEL_PATH above is normally English, and would
# mispronounce Arabic text badly. Replies get read aloud with whichever of
# these two matches the reply's own language (see VoiceController::speak).
# Leave blank to have Arabic replies fall back to the default voice above.
PIPER_MODEL_PATH_AR=
PIPER_TIMEOUT=20
