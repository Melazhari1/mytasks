# =============================================================================
#  MyTasks — production .env template
#
#  Copy to .env on the server, then:
#      php tools/keygen.php --write     # fills APP_KEY and JWT_SECRET
#      php tools/preflight.php --production
#
#  Do not copy your development .env up. APP_KEY must be generated once, on
#  the server, and then backed up somewhere separate from the database — it
#  is the only thing standing between a stolen dump and every vault password,
#  and it can never be rotated without destroying them.
# =============================================================================

APP_NAME="MyTasks"
APP_ENV=production
APP_DEBUG=false

# The API's own public base URL, no trailing slash.
# Sibling layout:  https://tasks.example.com/api
# Subdomain:       https://api.example.com
APP_URL=https://tasks.example.com/api

# Must be a real zone identifier. PHP's clock and MySQL's NOW() are pinned to
# it on every connection; get it wrong and every token, OTP and lockout expiry
# is off by the offset.
APP_TIMEZONE=Africa/Casablanca

# -----------------------------------------------------------------------------
#  Database — never root, never blank.
#
#  CREATE DATABASE mytasks CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#  CREATE USER 'mytasks'@'localhost' IDENTIFIED BY 'a-long-random-password';
#  GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, INDEX, ALTER, REFERENCES
#     ON mytasks.* TO 'mytasks'@'localhost';
#  FLUSH PRIVILEGES;
#
#  CREATE/INDEX/ALTER are there for tools/migrate.php. Drop them from the grant
#  once the schema is stable and re-add them for a migration if you prefer.
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mytasks
DB_USERNAME=mytasks
DB_PASSWORD=
DB_CHARSET=utf8mb4

# -----------------------------------------------------------------------------
#  Secrets — leave blank and let `php tools/keygen.php --write` fill them.
# -----------------------------------------------------------------------------
APP_KEY=
JWT_SECRET=

JWT_ISSUER=mytasks-api
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_CHALLENGE_TTL=300
JWT_VAULT_TTL=300

# -----------------------------------------------------------------------------
#  Session cookie
#
#  Secure is now also detected from the live request, but set it true here as
#  the explicit guarantee. SameSite stays Lax while the web client is served
#  from the same origin as the API — which is the recommended layout. Only use
#  None if they are on different origins, and then Secure MUST be true or the
#  browser rejects the cookie outright and every session dies at 15 minutes.
#
#  TRUSTED_PROXY=true tells the app to believe X-Forwarded-Proto. Turn it on
#  only when a reverse proxy or load balancer terminates TLS in front of PHP
#  (most managed hosting, Cloudflare, nginx -> php-fpm). Leaving it on without
#  a proxy lets a client claim HTTPS it does not have.
# -----------------------------------------------------------------------------
REFRESH_COOKIE_NAME=mytasks_refresh
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=Lax
TRUSTED_PROXY=false

# -----------------------------------------------------------------------------
#  CORS — list real origins. `*` no longer reflects an arbitrary Origin, but
#  an explicit list is still the only correct answer.
#  Leave blank entirely when the client is served from the same origin.
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
#  Two-factor
# -----------------------------------------------------------------------------
TWO_FACTOR_REQUIRED=true
OTP_LENGTH=6
OTP_TTL=300
OTP_MAX_ATTEMPTS=5
TOTP_ISSUER=MyTasks
TOTP_WINDOW=1

# -----------------------------------------------------------------------------
#  Mail — MUST be real SMTP in production.
#
#  With the log driver, one-time codes are written to a file instead of sent,
#  which means nobody but someone with server access can ever sign in.
# -----------------------------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="MyTasks"

# -----------------------------------------------------------------------------
#  Throttling
# -----------------------------------------------------------------------------
RATE_LIMIT_LOGIN=10
RATE_LIMIT_WINDOW=900
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# How long the audit trail is kept. Pruned by tools/reminders.php.
AUDIT_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
#  Backups
#
#  BACKUP_KEY gates the /backup HTTP routes, which reach EVERY user's data —
#  there is no admin role to gate them with instead. Leave it blank to disable
#  those routes entirely; tools/backup.php on the CLI never needs it.
#  If you do set it, make it 32+ random characters.
#
#  The archive contains .env — APP_KEY, JWT_SECRET, the DB password. Set
#  BACKUP_ZIP_PASSWORD before any backup leaves this server.
# -----------------------------------------------------------------------------
BACKUP_KEY=
BACKUP_KEEP=14
BACKUP_ZIP_PASSWORD=

GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_FOLDER_ID=

# -----------------------------------------------------------------------------
#  Optional local AI services.
#
#  All three are localhost-only processes. On a shared or managed host they
#  almost certainly are not running — leave these as they are and the mic,
#  the spoken replies and the free-form chat fallback simply stay unavailable.
#  Nothing else in the app is affected.
#
#  Never point these at a public address: there is no authentication between
#  the API and any of them.
# -----------------------------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=60

WHISPER_URL=http://127.0.0.1:8081
WHISPER_TIMEOUT=60
WHISPER_LANGUAGE=auto

PIPER_EXE_PATH=
PIPER_MODEL_PATH=
PIPER_MODEL_PATH_AR=
PIPER_TIMEOUT=20
